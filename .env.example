# Completá solo estos dos valores y reiniciá npm run dev.
RESEND_API_KEY=
# Sin dominio propio, debe ser el email de tu cuenta de Resend.
# También se muestra como contacto público en la web.
CONTACT_EMAIL=

# Opcional: remitente de un dominio verificado en Resend (para producción).
# Si se omite, usa Mate y Código <onboarding@resend.dev> (solo pruebas).
RESEND_FROM=

# Opcionales
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_BOOKING_URL=
